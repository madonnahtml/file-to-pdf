{
  "name": "immagini-in-pdf",
  "productName": "Immagini in PDF",
  "version": "1.0.0",
  "description": "Converti le tue immagini in un PDF, con editor di pagina, ritaglio e layout liberi.",
  "main": "src/main.js",
  "author": "madonnahtml",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "heic2any": "0.0.4",
    "pako": "^1.0.11",
    "pdf-lib": "1.17.1",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.madonnahtml.immaginiinpdf",
    "productName": "Immagini in PDF",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "artifactName": "Immagini-in-PDF-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Immagini in PDF",
      "artifactName": "Immagini-in-PDF-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Immagini-in-PDF-Portable-${version}.${ext}"
    }
  }
}
